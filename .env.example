# PostgreSQL connection string used by the app (local: docker compose up -d).
# On Neon use the pooled host (contains "-pooler").
DATABASE_URL="postgresql://crypto:crypto_local_dev@localhost:5433/crypto_ai_analyst?schema=public"
# Optional direct (non-pooled) connection for Prisma migrations. Falls back to DATABASE_URL.
DIRECT_URL=""

# OpenAI. If empty, explanations fall back to deterministic rule-based text.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Binance public market data. data-api.binance.vision is not geo-blocked for US cloud regions.
BINANCE_API_BASE_URL="https://data-api.binance.vision"
# USDT-M perpetual klines. Spot history is never mixed with these prices.
BINANCE_FUTURES_API_BASE_URL="https://fapi.binance.com"

# Requests per minute per client IP for POST /api/analyze
ANALYZE_RATE_LIMIT_PER_MINUTE="10"

# Telegram alerts. Token stays in .env only. Chat id can stay empty: it is filled after you press Start.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
